{
  "title": "yfactory",
  "uid": "yfactory",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "title": "Services up",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "title": "Runs by status",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "yf_runs",
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "title": "Queue / active / sandboxes",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "yf_runs_queue",
          "legendFormat": "queued",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        },
        {
          "refId": "B",
          "expr": "yf_runs_active",
          "legendFormat": "active",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        },
        {
          "refId": "C",
          "expr": "yf_vms",
          "legendFormat": "sandboxes",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "title": "Average run duration",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "yf_run_duration_seconds_sum / yf_run_duration_seconds_count",
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "title": "Finished runs",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (increase(yf_runs_finished_total[1h]))",
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "title": "Task API denials (401, 403)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route, code) (increase(yf_task_api_denied_total[10m]))",
          "legendFormat": "{{route}} {{code}}",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "title": "Sandbox operations",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (op, result) (increase(yf_sandbox_ops_total[10m]))",
          "legendFormat": "{{op}} {{result}}",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "title": "Sandbox seconds per operation",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(yf_sandbox_op_seconds_total[10m]) / increase(yf_sandbox_ops_total[10m])",
          "legendFormat": "{{op}}",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "title": "Provider token",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "yf_provider_ready",
          "legendFormat": "{{provider}}",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "title": "Container CPU (cores)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(rate(container_cpu_usage_seconds_total{id=~\"/system.slice/docker-.*\"}[5m]), \"c\", \"$1\", \"id\", \".*docker-(.{12}).*\")",
          "legendFormat": "{{c}}",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "title": "Container memory (working set)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(container_memory_working_set_bytes{id=~\"/system.slice/docker-.*\"}, \"c\", \"$1\", \"id\", \".*docker-(.{12}).*\")",
          "legendFormat": "{{c}}",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "title": "Container uptime",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(time() - container_start_time_seconds{id=~\"/system.slice/docker-.*\"}, \"c\", \"$1\", \"id\", \".*docker-(.{12}).*\")",
          "legendFormat": "{{c}}",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic"
      }
    },
    {
      "title": "Container restarts (range)",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "vm"
      },
      "gridPos": {
        "x": 12,
        "y": 38,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(changes(container_start_time_seconds{id=~\"/system.slice/docker-.*\"}[$__range]), \"c\", \"$1\", \"id\", \".*docker-(.{12}).*\")",
          "legendFormat": "{{c}}",
          "datasource": {
            "type": "prometheus",
            "uid": "vm"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic"
      }
    },
    {
      "title": "Errors in logs",
      "type": "logs",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "vlogs"
      },
      "gridPos": {
        "x": 0,
        "y": 46,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "error OR failed OR fatal",
          "legendFormat": "",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "vlogs"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
